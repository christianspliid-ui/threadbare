exports[`SceneStatePanel (C4) > renders the empty-fallback snapshot when nothing is present 1`] = `
<DocumentFragment>
  <section
    data-testid="encounter-scene-state-panel"
    style="display: flex; flex-direction: column; gap: 12px; padding: 12px; background: var(--bg-surface); border-top: 1px solid var(--border-subtle);"
  >
    <div
      data-testid="encounter-scene-threads"
    >
      <div
        style="font-family: var(--font-display); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: 6px;"
      >
        Threads In Play
      </div>
      <div
        style="font-size: 11px; font-style: italic; color: var(--text-muted); line-height: 1.4;"
      >
        no threads pulled tight
      </div>
    </div>
    <div
      data-testid="encounter-scene-factions"
    >
      <div
        style="font-family: var(--font-display); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: 6px;"
      >
        Factions Present
      </div>
      <div
        style="font-size: 11px; font-style: italic; color: var(--text-muted); line-height: 1.4;"
      >
        no factions present
      </div>
    </div>
    <div
      data-testid="encounter-scene-place-conditions"
    >
      <div
        style="font-family: var(--font-display); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: 6px;"
      >
        Place Conditions
      </div>
      <div
        style="font-size: 11px; font-style: italic; color: var(--text-muted); line-height: 1.4;"
      >
        the place rests ordinary
      </div>
    </div>
    <div
      data-testid="encounter-scene-protagonist-conditions"
    >
      <div
        style="font-family: var(--font-display); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: 6px;"
      >
        Conditions On Her
      </div>
      <div
        style="font-size: 11px; font-style: italic; color: var(--text-muted); line-height: 1.4;"
      >
        she carries nothing unusual
      </div>
    </div>
  </section>
</DocumentFragment>
`;

exports[`SceneStatePanel (C4) > renders the populated baseline snapshot 1`] = `
<DocumentFragment>
  <div
    style="width: 1920px; height: 1080px;"
  >
    <section
      data-testid="encounter-scene-state-panel"
      style="display: flex; flex-direction: column; gap: 12px; padding: 12px; background: var(--bg-surface); border-top: 1px solid var(--border-subtle);"
    >
      <div
        data-testid="encounter-scene-threads"
      >
        <div
          style="font-family: var(--font-display); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: 6px;"
        >
          Threads In Play
        </div>
        <div
          style="display: flex; flex-direction: column; gap: 6px;"
        >
          <div
            data-testid="encounter-thread-strip-oath"
            data-weight="taut"
            style="display: flex; align-items: center; gap: 10px; opacity: 1;"
          >
            <svg
              aria-hidden="true"
              height="6"
              style="flex-shrink: 0;"
              width="48"
            >
              <line
                stroke="var(--sphere-spirit-bright)"
                stroke-linecap="round"
                stroke-width="2"
                x1="0"
                x2="48"
                y1="3"
                y2="3"
              />
            </svg>
            <span
              style="font-size: 12px; color: var(--text-secondary); font-style: normal; line-height: 1.35;"
            >
              an oath she has not paid
            </span>
          </div>
          <div
            data-testid="encounter-thread-strip-rumor"
            data-weight="thin"
            style="display: flex; align-items: center; gap: 10px; opacity: 0.75;"
          >
            <svg
              aria-hidden="true"
              height="5.2"
              style="flex-shrink: 0;"
              width="48"
            >
              <line
                stroke="var(--sphere-mind-bright)"
                stroke-linecap="round"
                stroke-width="1.2"
                x1="0"
                x2="48"
                y1="2.6"
                y2="2.6"
              />
            </svg>
            <span
              style="font-size: 12px; color: var(--text-secondary); font-style: normal; line-height: 1.35;"
            >
              a rumor sharpening into a name
            </span>
          </div>
        </div>
      </div>
      <div
        data-testid="encounter-scene-factions"
      >
        <div
          style="font-family: var(--font-display); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: 6px;"
        >
          Factions Present
        </div>
        <div
          style="display: flex; flex-wrap: wrap; gap: 6px;"
        >
          <span
            data-testid="encounter-scene-faction-Civic Guard"
            style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent-gold-dim); border: 1px solid var(--border-subtle); border-radius: 999px; padding: 2px 8px; background: var(--bg-raised);"
          >
            Civic Guard
          </span>
        </div>
      </div>
      <div
        data-testid="encounter-scene-place-conditions"
      >
        <div
          style="font-family: var(--font-display); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: 6px;"
        >
          Place Conditions
        </div>
        <ul
          style="list-style: none; margin: 0px; padding: 0px; display: flex; flex-direction: column; gap: 3px;"
        >
          <li
            data-testid="encounter-scene-place-condition-0"
            style="font-size: 12px; color: var(--text-secondary); line-height: 1.4;"
          >
            the gate is shut
          </li>
        </ul>
      </div>
      <div
        data-testid="encounter-scene-protagonist-conditions"
      >
        <div
          style="font-family: var(--font-display); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: 6px;"
        >
          Conditions On Her
        </div>
        <ul
          style="list-style: none; margin: 0px; padding: 0px; display: flex; flex-direction: column; gap: 3px;"
        >
          <li
            data-testid="encounter-scene-protagonist-condition-0"
            style="font-size: 12px; color: var(--text-secondary); line-height: 1.4;"
          >
            her name is known here
          </li>
        </ul>
      </div>
    </section>
  </div>
</DocumentFragment>
`;

