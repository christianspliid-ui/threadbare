// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`DetectionThread threshold tiers > renders ENCOUNTER band snapshot at pressure ≥ 1.00 > detection-encounter 1`] = `
<DocumentFragment>
  <div
    data-band="encounter"
    data-testid="encounter-detection-thread"
    style="display: flex; align-items: center; gap: 10px; opacity: 1;"
  >
    <svg
      aria-hidden="true"
      height="8"
      style="flex-shrink: 0;"
      width="48"
    >
      <line
        stroke="var(--text-primary)"
        stroke-linecap="round"
        stroke-width="4"
        x1="0"
        x2="48"
        y1="4"
        y2="4"
      />
    </svg>
    <span
      style="font-size: 13px; font-weight: 700; color: var(--text-primary); font-style: italic; line-height: 1.35;"
    >
      a rival god has fixed its gaze on her
    </span>
  </div>
</DocumentFragment>
`;

exports[`DetectionThread threshold tiers > renders NOTICE band snapshot at pressure ≥ 0.50 > detection-notice 1`] = `
