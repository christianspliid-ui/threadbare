  </div>
</DocumentFragment>
`;

exports[`DriftIndicator threshold tiers > renders BANNER tier snapshot > drift-banner 1`] = `
<DocumentFragment>
  <div
    data-axis-id="protector_conqueror"
    data-band="banner"
    data-testid="encounter-drift-indicator"
    style="display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 6px 8px; border-top: 1px solid var(--border-subtle);"
  >
    <em
      style="font-size: 12px; color: var(--text-secondary); letter-spacing: 0.02em; font-weight: 500; line-height: 1.4; flex: 1 1 0%;"
    >
      Eira has tilted toward Conqueror at the banner tier.
    </em>
    <button
      aria-label="dismiss drift indicator"
      data-testid="encounter-drift-indicator-dismiss"
      style="background: transparent; border: medium; color: var(--text-muted); font-size: 14px; cursor: pointer; padding: 0px 4px; line-height: 1;"
      type="button"
    >
      ×
    </button>
  </div>
</DocumentFragment>
`;

