              />
              <div
                style="min-width: 0px;"
              >
                <div
                  data-testid="ascendant-hand-card-name-b"
                  style="font-size: 13px; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"
                >
                  Veil the trader's cargo
                </div>
              </div>
            </div>
            <div
              data-testid="ascendant-hand-card-cost-b"
              style="flex-shrink: 0; font-size: 9px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--text-muted);"
            >
              fuller breath
            </div>
          </div>
        </div>
        <div
          aria-disabled="false"
          aria-label="Still the guard"
          data-rare="false"
          data-reach="iron"
          data-state="playable"
          data-testid="ascendant-hand-card-c"
