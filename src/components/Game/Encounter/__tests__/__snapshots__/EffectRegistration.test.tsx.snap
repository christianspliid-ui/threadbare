    >
      <span
        aria-hidden="true"
        style="position: absolute; top: 4px; right: 6px; width: 6px; height: 6px; border-radius: 999px; background: var(--sphere-time-bright); --mark-color: var(--sphere-time-bright); animation: mark-pulse 360ms ease-out 1;"
      />
