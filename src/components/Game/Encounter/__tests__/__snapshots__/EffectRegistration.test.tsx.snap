// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`EffectRegistration 1920×1080 snapshot grid > renders ArchetypeDriftLanding at 1920×1080 1`] = `
<DocumentFragment>
  <div
    style="position: relative; width: 1920px; height: 1080px;"
  >
    <div
      data-phase="settled"
      data-testid="effect-registration-archetype-drift"
      style="position: relative; padding: 8px 10px; border-radius: 8px; background: var(--bg-raised); border-left: 2px solid var(--sphere-spirit-bright);"
    >
      <div
        style="font-size: 9px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--sphere-spirit-bright);"
      >
        HEART · DRIFT
      </div>
      <span
        aria-hidden="true"
        data-testid="effect-registration-archetype-drift-dot"
        style="display: inline-block; width: 8px; height: 8px; border-radius: 999px; margin-right: 6px; margin-top: 4px; background-color: var(--sphere-spirit-bright); opacity: 1; transition: opacity 240ms ease-out;"
      />
      <span
        style="font-size: 12px; color: var(--text-primary); opacity: 1; transition: opacity 240ms ease-out;"
      >
        the thread she lives by
      </span>
      <div
        style="font-size: 11px; font-style: italic; color: var(--text-tertiary); margin-top: 2px;"
      >
        +1 dot · she is more this now
      </div>
      <span
        aria-hidden="true"
        style="position: absolute; top: -4px; left: 8px; width: 3px; height: 3px; border-radius: 999px; background: var(--sphere-chaos-bright); opacity: 0.45; --mark-color: var(--sphere-chaos-bright); animation: mark-pulse 480ms ease-out 1;"
      />
    </div>
  </div>
</DocumentFragment>
`;

