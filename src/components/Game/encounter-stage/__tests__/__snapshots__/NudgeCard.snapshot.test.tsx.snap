exports[`NudgeCard DOM (pre-extraction pin — THR-1002) > renders a chipless one-off card with no sphere 1`] = `
<button
  aria-pressed="false"
  class="focus-ring"
  data-nudge-blocked=""
  data-nudge-keyword=""
  data-nudge-state="playable"
  data-testid="nudge-card-nudge.steady_hand"
  style="display: flex; flex-direction: column; align-items: stretch; gap: 0px; width: 210px; flex-shrink: 0; padding: 0px; text-align: left; border-radius: 10px; overflow: hidden; background: rgba(255, 255, 255, 0.02); border: 1px solid rgb(var(--veil-gold-rgb) / 0.18); opacity: 1; cursor: pointer; transition: opacity 0.2s ease, border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;"
  type="button"
>
  <div
    aria-label="Steady The Hand"
    data-entity-visual-tier="art"
    data-testid="nudge-card-art-nudge.steady_hand"
    role="img"
    style="position: relative; overflow: hidden; border-radius: 0px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(88, 60, 120, 0.44) 0%, rgba(10, 10, 15, 0.95) 74%); width: 100%; aspect-ratio: auto; height: 78px; border-width: 0px 0px 1px;"
  >
    <img
      alt="Steady The Hand"
      loading="lazy"
      src="/concept-art/nudge/blessing.jpg"
      style="width: 100%; height: 100%; object-fit: cover; display: block;"
    />
  </div>
  <div
    style="display: flex; flex-direction: column; gap: 6px; padding: 10px 12px 12px; flex: 1 1 0%;"
  >
    <div
      style="display: flex; align-items: center; justify-content: space-between; gap: 6px;"
    >
      <span />
      <span
        style="display: flex; align-items: center; gap: 6px; flex-shrink: 0;"
      >
        <span
          aria-label="2 essence"
          data-cost-framed="true"
          data-cost-pips="2"
          data-testid="nudge-card-cost-nudge.steady_hand"
          role="img"
          style="font-size: 14px; line-height: 1; letter-spacing: 0.14em; color: var(--veil-gold); white-space: nowrap; display: inline-flex; align-items: center; padding: 2px 7px; border-radius: 5px; border: 1px solid rgb(var(--veil-gold-rgb) / 0.4); background: rgb(var(--veil-gold-rgb) / 0.1);"
          title="2 essence"
        >
          <span
            aria-hidden="true"
          >
            ✦✦
          </span>
        </span>
      </span>
    </div>
    <span
      style="font-family: "Palatino Linotype", "Book Antiqua", Palatino, serif; font-size: var(--text-sm); line-height: 1.25; color: var(--veil-text-bright);"
    >
      Steady The Hand
    </span>
    <div
      style="display: flex; flex-direction: column; gap: 4px;"
    >
      <span
        style="font-size: var(--text-xs); line-height: 1.5; color: var(--veil-text-whisper);"
      >
        His grip stops shaking.
      </span>
      <span
        aria-label="Faint, 2 of 5"
        data-pip-filled="2"
        data-pip-tier="faint"
        data-testid="nudge-card-odds-nudge.steady_hand"
        role="img"
        style="font-size: 14px; line-height: 1; letter-spacing: 0.14em; color: rgba(134, 239, 172, 0.9); opacity: 1; white-space: nowrap;"
        title="Faint, 2 of 5"
      >
        <span
          aria-hidden="true"
        >
          ●●○○○
        </span>
      </span>
    </div>
    <div
      style="margin-top: auto;"
    />
  </div>
</button>
`;

