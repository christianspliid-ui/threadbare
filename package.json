{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prebuild": "npm run generate-ul-dashboard && npm run generate-impediment-dashboard && npm run generate-design-wiki",
    "generate-ul-dashboard": "esbuild scripts/generate-ul-dashboard-data.ts --bundle --platform=node --format=esm --outfile=.cache/generate-ul-dashboard-data.mjs --external:fs --external:path --external:url && node .cache/generate-ul-dashboard-data.mjs",
    "generate-ul-dashboard:dry": "esbuild scripts/generate-ul-dashboard-data.ts --bundle --platform=node --format=esm --outfile=.cache/generate-ul-dashboard-data.mjs --external:fs --external:path --external:url && node .cache/generate-ul-dashboard-data.mjs --dry-run",
    "generate-impediment-dashboard": "esbuild scripts/generate-impediment-dashboard.ts --bundle --platform=node --format=esm --outfile=.cache/generate-impediment-dashboard.mjs --external:fs --external:path --external:url && node .cache/generate-impediment-dashboard.mjs",
    "generate-design-wiki": "esbuild scripts/generate-design-wiki.ts --bundle --platform=node --format=esm --outfile=.cache/generate-design-wiki.mjs --external:fs --external:path --external:url && node .cache/generate-design-wiki.mjs",
    "generate-design-wiki:dry": "esbuild scripts/generate-design-wiki.ts --bundle --platform=node --format=esm --outfile=.cache/generate-design-wiki.mjs --external:fs --external:path --external:url && node .cache/generate-design-wiki.mjs --dry-run",
    "check:design-wiki": "esbuild scripts/check-design-wiki.ts --bundle --platform=node --format=esm --outfile=.cache/check-design-wiki.mjs --external:fs --external:path --external:url && node .cache/check-design-wiki.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:regression": "vitest run --passWithNoTests \"regression|contract\"",
    "drift-scan": "node --experimental-strip-types scripts/drift-scan/index.ts",
    "check:skill-sync": "node scripts/check-skill-sync.js",
    "check:skill-sync:sync": "node scripts/check-skill-sync.js --sync",
    "retro-draft": "esbuild scripts/retro-draft.ts --bundle --platform=node --format=esm --outfile=.cache/retro-draft.mjs --external:crypto --external:fs --external:path --external:process --external:url && node .cache/retro-draft.mjs",
    "build-authoring-brief": "esbuild scripts/build-authoring-brief.ts --bundle --platform=node --format=esm --outfile=.cache/build-authoring-brief.mjs --external:crypto --external:fs --external:path --external:process --external:url && node .cache/build-authoring-brief.mjs",
    "check:authoring-brief": "esbuild scripts/check-authoring-brief.ts --bundle --platform=node --format=esm --outfile=.cache/check-authoring-brief.mjs --external:crypto --external:fs --external:path --external:process --external:url && node .cache/check-authoring-brief.mjs",
    "check:canon-staleness": "node --experimental-strip-types scripts/check-canon-staleness.ts",
    "vision-audit": "node --experimental-strip-types scripts/vision-audit.ts",
    "lint:encounter-content": "esbuild scripts/lint-encounter-content.ts --bundle --platform=node --format=esm --outfile=.cache/lint-encounter-content.mjs --external:fs --external:path --external:process --external:url && node .cache/lint-encounter-content.mjs",
    "lint:plan-doc": "esbuild scripts/lint-plan-doc.ts --bundle --platform=node --format=esm --outfile=.cache/lint-plan-doc.mjs --external:child_process --external:fs --external:path --external:process --external:url && node .cache/lint-plan-doc.mjs",
    "lint:intel-prose-category": "esbuild scripts/lint-intel-prose-category.ts --bundle --platform=node --format=esm --outfile=.cache/lint-intel-prose-category.mjs --external:fs --external:path --external:process --external:url && node .cache/lint-intel-prose-category.mjs",
    "lint:find-first": "esbuild scripts/lint-find-first.ts --bundle --platform=node --format=esm --outfile=.cache/lint-find-first.mjs --external:path --external:process --external:url && node .cache/lint-find-first.mjs",
    "check:process": "esbuild scripts/check-process.ts --bundle --platform=node --format=esm --outfile=.cache/check-process.mjs --external:child_process --external:fs --external:path --external:process --external:url && node .cache/check-process.mjs && npm run check:authoring-brief && npm run check:design-wiki",
    "generate-vault": "esbuild scripts/generate-vault.ts --bundle --platform=node --format=esm --outfile=.cache/generate-vault.mjs --external:fs --external:path && node .cache/generate-vault.mjs",
    "generate-vault:dry": "esbuild scripts/generate-vault.ts --bundle --platform=node --format=esm --outfile=.cache/generate-vault.mjs --external:fs --external:path && node .cache/generate-vault.mjs --dry-run",
    "mirror-ul": "esbuild scripts/mirror-ul.ts --bundle --platform=node --format=esm --outfile=.cache/mirror-ul.mjs --external:fs --external:path && node .cache/mirror-ul.mjs",
    "mirror-ul:dry": "esbuild scripts/mirror-ul.ts --bundle --platform=node --format=esm --outfile=.cache/mirror-ul.mjs --external:fs --external:path && node .cache/mirror-ul.mjs --dry-run",
    "sync-vault": "npm run generate-vault && npm run mirror-ul",
    "validate-model": "esbuild scripts/validate-world-model.ts --bundle --platform=node --format=esm --outfile=/tmp/validate-world-model.mjs --external:fs --external:path && node /tmp/validate-world-model.mjs",
    "generate-hex": "python scripts/generate-hex-tile.py",
    "generate-hex:terrain": "python scripts/generate-hex-tile.py --category terrain --batch",
    "generate-hex:magic": "python scripts/generate-hex-tile.py --category magic --batch",
    "generate-hex:audit": "python scripts/generate-hex-tile.py --audit",
    "generate-hex:all": "python scripts/generate-hex-tile.py --batch-all",
    "resize-tiles": "esbuild scripts/resize-hex-tiles.ts --bundle --platform=node --format=esm --outfile=scripts/resize-hex-tiles.mjs --external:sharp --external:fs --external:path --external:url && node scripts/resize-hex-tiles.mjs",
    "playtest": "esbuild scripts/playtest.ts --bundle --platform=node --format=esm --outfile=/tmp/playtest.mjs --external:fs --external:path && node /tmp/playtest.mjs",
    "ingest": "esbuild scripts/ingest-inspiration.ts --bundle --platform=node --format=esm --outfile=.cache/ingest-inspiration.mjs --external:fs --external:path --external:crypto --external:url && node .cache/ingest-inspiration.mjs",
    "cli": "esbuild scripts/cli.ts --bundle --platform=node --format=esm --outfile=.cache/cli.mjs --external:fs --external:path && node .cache/cli.mjs",
    "balance:smoke": "esbuild scripts/balance-eval.ts --bundle --platform=node --format=esm --outfile=.cache/balance-eval-smoke.mjs --external:fs --external:path && node .cache/balance-eval-smoke.mjs --profile smoke",
    "balance:cadence": "esbuild scripts/balance-eval.ts --bundle --platform=node --format=esm --outfile=.cache/balance-eval-cadence.mjs --external:fs --external:path && node .cache/balance-eval-cadence.mjs --profile cadence",
    "balance:journey": "esbuild scripts/balance-eval.ts --bundle --platform=node --format=esm --outfile=.cache/balance-eval-journey.mjs --external:fs --external:path && node .cache/balance-eval-journey.mjs --profile journey",
    "balance:seed": "esbuild scripts/balance-eval.ts --bundle --platform=node --format=esm --outfile=.cache/balance-eval-seed.mjs --external:fs --external:path && node .cache/balance-eval-seed.mjs",
    "gameplay-report": "esbuild scripts/gameplay-report.ts --bundle --platform=node --format=esm --outfile=.cache/gameplay-report.mjs --external:fs --external:path && node .cache/gameplay-report.mjs",
    "volume-model": "esbuild scripts/encounter-volume-model.ts --bundle --platform=node --format=esm --outfile=.cache/encounter-volume-model.mjs --external:fs --external:path --external:url && node .cache/encounter-volume-model.mjs",
    "content-census": "esbuild scripts/content-census.ts --bundle --platform=node --format=esm --outfile=.cache/content-census.mjs --external:fs --external:path && node .cache/content-census.mjs",
    "rebuild-index": "esbuild scripts/rebuild-index.ts --bundle --platform=node --format=esm --outfile=.cache/rebuild-index.mjs --external:fs --external:path && node .cache/rebuild-index.mjs",
    "rebuild-index:dry": "esbuild scripts/rebuild-index.ts --bundle --platform=node --format=esm --outfile=.cache/rebuild-index.mjs --external:fs --external:path && node .cache/rebuild-index.mjs --dry-run",
    "enhance-frontmatter": "esbuild scripts/enhance-frontmatter.ts --bundle --platform=node --format=esm --outfile=.cache/enhance-frontmatter.mjs --external:fs --external:path --external:child_process && node .cache/enhance-frontmatter.mjs",
    "enhance-frontmatter:dry": "esbuild scripts/enhance-frontmatter.ts --bundle --platform=node --format=esm --outfile=.cache/enhance-frontmatter.mjs --external:fs --external:path --external:child_process && node .cache/enhance-frontmatter.mjs --dry-run",
    "review:build": "esbuild scripts/review/wrapper.ts --bundle --platform=node --format=esm --outfile=.cache/review-wrapper.mjs --external:child_process --external:fs --external:path --external:url && esbuild scripts/review/review-client.ts --bundle --platform=node --format=esm --outfile=.cache/review-client.mjs --external:fs --external:path --external:url && esbuild scripts/review/test/clean-exit.ts --bundle --platform=node --format=esm --outfile=.cache/review-test-clean.mjs --external:fs --external:path && esbuild scripts/review/test/stall.ts --bundle --platform=node --format=esm --outfile=.cache/review-test-stall.mjs",
    "review:run": "npm run review:build && node .cache/review-wrapper.mjs node .cache/review-client.mjs",
    "review:test:clean": "npm run review:build && node .cache/review-wrapper.mjs node .cache/review-test-clean.mjs",
    "review:test:stall": "npm run review:build && node .cache/review-wrapper.mjs node .cache/review-test-stall.mjs",
    "audit-ia": "esbuild scripts/audit-ia-manifest.ts --bundle --platform=node --format=esm --outfile=.cache/audit-ia-manifest.mjs --external:fs --external:path --external:url && node .cache/audit-ia-manifest.mjs",
    "eval:prose": "esbuild scripts/eval-prose-quality.ts --bundle --platform=node --format=esm --outfile=.cache/eval-prose-quality.mjs --external:fs --external:path --external:process --external:url && node .cache/eval-prose-quality.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@sentry/react": "^10.49.0",
    "@types/d3": "^7.4.3",
    "@types/three": "^0.183.1",
    "d3": "^7.9.0",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simplex-noise": "^4.0.3",
    "three": "^0.183.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
