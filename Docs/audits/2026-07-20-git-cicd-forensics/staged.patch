-interface SubsystemView extends Subsystem { badge: Badge; phaseIds: string[] }
-
-function render(args: Args, subsystems: SubsystemView[], phases: PhaseRow[], domains: DomainRow[], unclaimed: PhaseRow[], ran: boolean): string {
