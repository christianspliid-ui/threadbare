{
  "enabledPlugins": {
    "playground@claude-plugins-official": false,
    "webgpu-threejs-tsl@webgpu-threejs-tsl": false,
    "vercel@claude-plugins-official": false,
    "miro@claude-plugins-official": false,
    "productivity@synced": false,
    "design@synced": false,
    "engineering@synced": false,
    "product-management@synced": false,
    "data@synced": false,
    "finance@synced": false,
    "cowork-plugin-management@synced": false
  },
  "deniedMcpServers": [
    { "serverName": "ms365" },
    { "serverName": "dk-bogfoerer" },
    { "serverName": "billy" },
    { "serverName": "claude.ai Claude Docs" },
    { "serverName": "claude.ai Higgsfield" },
    { "serverName": "claude.ai outlook mcp home made" },
    { "serverName": "claude.ai Microsoft 365" },
    { "serverName": "claude.ai nanobanana" },
    { "serverName": "claude.ai Google Drive" },
    { "serverName": "claude.ai Vercel" },
    { "serverName": "claude.ai Gmail" },
    { "serverName": "claude.ai Google Calendar" },
    { "serverName": "claude.ai Notion" },
    { "serverName": "claude.ai Miro" },
    { "serverName": "claude.ai Slack" }
  ],
  "permissions": {
    "allow": [
      "mcp__7aa97de8-78a2-4b5d-a6e0-0aabc5d0bb68__list_issues",
      "mcp__7aa97de8-78a2-4b5d-a6e0-0aabc5d0bb68__get_issue",
      "mcp__7aa97de8-78a2-4b5d-a6e0-0aabc5d0bb68__list_comments",
      "mcp__7aa97de8-78a2-4b5d-a6e0-0aabc5d0bb68__list_projects",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__find",
      "mcp__scheduled-tasks__list_scheduled_tasks",
      "PowerShell(Get-Content *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{
          "type": "command",
          "command": "node .claude/hooks/worktree-write-guard.mjs",
          "timeout": 10,
          "statusMessage": "Checking worktree write path..."
        }]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{
          "type": "command",
          "command": "bash .claude/hooks/review-gate.sh",
          "timeout": 60,
          "statusMessage": "Review gate: checking for a clean review receipt..."
        }]
      }
    ],
    "Stop": [
      {
        "hooks": [{
          "type": "command",
          "command": "bash .claude/hooks/session-stop-gate.sh",
          "timeout": 15,
          "statusMessage": "Checking for loose ends..."
        }]
      }
    ]
  }
}
